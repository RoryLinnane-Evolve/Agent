<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Ragent</RootNamespace>
        <PackageId>Ragent</PackageId>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageProjectUrl>https://github.com/RoryLinnane-Evolve/Agent</PackageProjectUrl>
        <Version>0.0.0</Version>
        <Authors>Rory Linnane</Authors>
        <Description>A lightweight .NET agentic framework with tool discovery, LLM abstraction, and configuration.</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/RoryLinnane-Evolve/Agent</RepositoryUrl>
        <PackageTags>agent;llm;ai;gemini;ollama;tools</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\docs\RAGENT_NUGET_README.md" Pack="true" PackagePath="\README.md" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Google.GenAI" Version="0.6.0" />
        <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.9" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
        <EmbeddedResource Include="Prompts\tool_picker_prompt.md"/>
    </ItemGroup>

</Project>
